# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
# Globbed: this repository has needed a second interpreter's venv beside the
# first (.venv312 against Python 3.12), and an un-ignored one is 20,000 files
# of commit-eligible noise.
.venv*/
venv/
env/

# Environment
.env

# IDE/editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Runtime/cache data
# Anchored to the repository root with a leading slash, deliberately. Unanchored,
# `models/` matched src/marp_inference_worker/models/ as well as the artifact
# cache, so the entire source models package -- model_spec.py included, which
# every engine imports -- was ignored and had never been committed. A fresh clone
# could not import the worker. The other five are anchored for the same reason
# before they trip over a source directory of the same name.
/data/
/datasets/
/models/
/runs/
/logs/
/tmp/

# Model artifacts
*.pt
*.onnx
*.engine
*.weights

# --- Harness: machine-specific operational notes ---
# Hosts, accounts and key paths for one developer. Repository files may say that a
# credential exists and where it lives, never its value.
.marp/local/
